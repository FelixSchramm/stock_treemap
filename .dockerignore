# Build context hygiene. The Dockerfile also copies only an explicit allowlist.
**/.git
.github
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.DS_Store
**/.env
**/.env.*
!**/.env.example
**/secrets.toml
**/*credentials*.json
**/*service-account*.json
**/*service_account*.json
**/*.pem
**/*.key
**/secrets
**/data
**/exports
**/cache
**/.cache
**/logs
**/*.log
**/heatmap.html
**/tickers.txt
docs/private
**/*.local.*
.github-import-state.json
tests
agent_architecture
# Private persistent state must only be mounted at runtime, outside /app.
**/private
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.bak
**/*.backup
**/*watchlist*.json
**/*watchlist*.csv
**/*watchlist*.txt
