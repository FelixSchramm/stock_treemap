# Reference only: load_config reads exported variables, not this file.
# Demo ignores all real source/login settings and never uses these placeholders.
# demo, local (own Sheet on 127.0.0.1 without login) or production.
PORTFOLIO_MODE=demo
PORTFOLIO_SOURCE=google_sheets
PORTFOLIO_PROVIDER=yfinance
PORTFOLIO_QUOTES_TTL_SECONDS=60
PORTFOLIO_HOLDINGS_TTL_SECONDS=300
PORTFOLIO_HISTORY_TTL_SECONDS=21600
PORTFOLIO_LOGIN_PROVIDER=google
PORTFOLIO_OWNER_ISSUER=<VALIDATED_OWNER_ISSUER>
PORTFOLIO_OWNER_SUBJECT=<VALIDATED_OWNER_SUBJECT>
# OIDC client/cookie/callback settings belong only in Streamlit's server [auth]
# section; see .streamlit/secrets.example.toml. These are separate from Sheets.
PORTFOLIO_SHEET_ID=<PRIVATE_SOURCE_ID>
PORTFOLIO_SHEET_RANGE=<PRIVATE_WORKSHEET_RANGE>
# Optional watchlist tab of the same Sheet (ADR 0011): Tab!A1:D300 up to Tab!A1:T...
PORTFOLIO_WATCHLIST_RANGE=
# Local mode only: key file and optional owner-verified listings (see README).
# Production reads [sheets_service_account] and [[listing]] from host secrets.
PORTFOLIO_SHEETS_CREDENTIALS_FILE=<LOCAL_CREDENTIAL_FILE>
PORTFOLIO_LISTINGS_FILE=
# Optional private SQLite state: explicit absolute dedicated directory outside
# checkout and /app, with persistent host storage (0700); never used in demo.
PORTFOLIO_PRIVATE_DATA_DIR=
