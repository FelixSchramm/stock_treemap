# Reference only: load_config reads exported variables, not this file.
# Demo ignores all real source/login settings and never uses these placeholders.
PORTFOLIO_MODE=demo
PORTFOLIO_SOURCE=google_sheets
PORTFOLIO_PROVIDER=yfinance
PORTFOLIO_QUOTES_TTL_SECONDS=60
PORTFOLIO_HOLDINGS_TTL_SECONDS=300
PORTFOLIO_HISTORY_TTL_SECONDS=21600
PORTFOLIO_LOGIN_PROVIDER=google
PORTFOLIO_OWNER_ISSUER=<VALIDATED_OWNER_ISSUER>
PORTFOLIO_OWNER_SUBJECT=<VALIDATED_OWNER_SUBJECT>
PORTFOLIO_OIDC_CLIENT_ID=<OIDC_CLIENT_ID>
PORTFOLIO_OIDC_CLIENT_SECRET=<OIDC_CLIENT_SECRET>
PORTFOLIO_COOKIE_SECRET=<RANDOM_SERVER_SIDE_COOKIE_SECRET>
PORTFOLIO_OIDC_REDIRECT_URI=<HTTPS_OAUTH2_CALLBACK_URL>
PORTFOLIO_SHEET_ID=<PRIVATE_SOURCE_ID>
PORTFOLIO_SHEET_RANGE=<PRIVATE_WORKSHEET_RANGE>
PORTFOLIO_SHEETS_CREDENTIALS_FILE=<SERVER_SIDE_CREDENTIAL_FILE>
